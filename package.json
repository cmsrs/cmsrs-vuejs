{
  "name": "rs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --watch=false   --testTimeout 10000",
    "test:unit": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "test:coverage": "vitest --coverage --watch=false   --testTimeout 10000",
    "test:coverage-v2": "node --max-old-space-size=4096  ./node_modules/.bin/vitest --coverage --watch=false   --testTimeout 10000",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-vue": "^5.1.0",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "prettier": "^3.9.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
